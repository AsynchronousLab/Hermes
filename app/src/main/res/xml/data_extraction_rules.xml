<?xml version="1.0" encoding="utf-8"?>
<!--
  The app stores the backend password (Keystore-encrypted) and session ids.
  Keep all of it out of cloud backup and device-to-device transfer so the
  credentials never leave the phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>