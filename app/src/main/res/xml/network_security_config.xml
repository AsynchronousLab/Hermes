<?xml version="1.0" encoding="utf-8"?>
<!--
  Hermes backends usually live on a LAN address over plain http, and users enter
  the base URL themselves in Settings. Cleartext therefore has to stay allowed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>